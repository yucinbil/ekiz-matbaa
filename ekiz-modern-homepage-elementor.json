          "elements": [
            {
              "id": "ekiz_prod_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div class=\"container\">\n    <div class=\"text-center\" style=\"margin-bottom: 45px;\">\n        <span style=\"color: #f4544c; font-weight: 700; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px;\">Üretim Alanlarımız</span>\n        <h2 style=\"font-size: 2.3rem; font-weight: 800; color: #1e2229; margin-top: 8px;\">Öne Çıkan Baskı & Matbaa Ürünlerimiz</h2>\n        <p style=\"color: #6c757d; max-width: 650px; margin: 10px auto 0 auto; font-size: 1.05rem;\">Kurumsal firmanızın prestijini artıran yüksek kaliteli kağıt, özel kaplama ve hassas kesim seçenekleri.</p>\n    </div>\n\n    <div class=\"ekiz-products-grid\">\n        <!-- 1. Kutu & Ambalaj -->\n        <div class=\"ekiz-product-card\">\n            <div>\n                <div class=\"ekiz-card-icon\"><i class=\"porto-icon-cart\"></i></div>\n                <h3 class=\"ekiz-card-title\">Ambalaj & Kutu</h3>\n                <p class=\"ekiz-card-desc\">Özel ebat lüks sert kutular, katlamalı ürün kutuları, mat/parlak selefon, kısmi lak ve altın/gümüş varak yaldız uygulamaları.</p>\n            </div>\n            <a href=\"/shop/\" class=\"ekiz-card-link\">Detayları Gör &rarr;</a>\n        </div>\n\n        <!-- 2. Katalog & Dergi -->\n        <div class=\"ekiz-product-card\">\n            <div>\n                <div class=\"ekiz-card-icon\"><i class=\"porto-icon-doc\"></i></div>\n                <h3 class=\"ekiz-card-title\">Katalog & Dergi</h3>\n                <p class=\"ekiz-card-desc\">Ürünlerinizi en etkileyici şekilde sergileyen tel dikişli, iplik dikişli ve Amerikan ciltli yüksek çözünürlüklü ofset kataloglar.</p>\n            </div>\n            <a href=\"/shop/\" class=\"ekiz-card-link\">Detayları Gör &rarr;</a>\n        </div>\n\n        <!-- 3. Broşür & El İlanı -->\n        <div class=\"ekiz-product-card\">\n            <div>\n                <div class=\"ekiz-card-icon\"><i class=\"porto-icon-tag\"></i></div>\n                <h3 class=\"ekiz-card-title\">Broşür & El İlanı</h3>\n                <p class=\"ekiz-card-desc\">Tek kırım, z kırım, akordiyon katlama; 135gr - 350gr kaliteli kuşe kağıt üzerine canlı renkli tanıtım broşürleri.</p>\n            </div>\n            <a href=\"/shop/\" class=\"ekiz-card-link\">Detayları Gör &rarr;</a>\n        </div>\n\n        <!-- 4. Karton Çanta -->\n        <div class=\"ekiz-product-card\">\n            <div>\n                <div class=\"ekiz-card-icon\"><i class=\"porto-icon-bag\"></i></div>\n                <h3 class=\"ekiz-card-title\">Karton Çanta</h3>\n                <p class=\"ekiz-card-desc\">Özel ip kulp, kurdele kulp, taban ve ağız takviyeli, kurumsal markanıza özel lüks baskılı karton mağaza çantaları.</p>\n            </div>\n            <a href=\"/shop/\" class=\"ekiz-card-link\">Detayları Gör &rarr;</a>\n        </div>\n\n        <!-- 5. Kurumsal Kimlik -->\n        <div class=\"ekiz-product-card\">\n            <div>\n                <div class=\"ekiz-card-icon\"><i class=\"porto-icon-badge\"></i></div>\n                <h3 class=\"ekiz-card-title\">Kurumsal Kimlik</h3>\n                <p class=\"ekiz-card-desc\">Prestijli kartvizitler (kabartma laklı, sıvamalı), antetli kağıt, pencereli diplomat zarf ve cepli kurumsal sunum klasörleri.</p>\n            </div>\n            <a href=\"/shop/\" class=\"ekiz-card-link\">Detayları Gör &rarr;</a>\n        </div>\n\n        <!-- 6. Defter & Ajanda -->\n        <div class=\"ekiz-product-card\">\n            <div>\n                <div class=\"ekiz-card-icon\"><i class=\"porto-icon-notebook\"></i></div>\n                <h3 class=\"ekiz-card-title\">Defter & Ajanda</h3>\n                <p class=\"ekiz-card-desc\">Termo deri, sert ciltli, spiralli bloknot ve şirket logosu gofre baskılı promosyon ajanda üretimi.</p>\n            </div>\n            <a href=\"/shop/\" class=\"ekiz-card-link\">Detayları Gör &rarr;</a>\n        </div>\n\n        <!-- 7. Etiket & Çıkartma -->\n        <div class=\"ekiz-product-card\">\n            <div>\n                <div class=\"ekiz-card-icon\"><i class=\"porto-icon-layers\"></i></div>\n                <h3 class=\"ekiz-card-title\">Etiket & Çıkartma</h3>\n                <p class=\"ekiz-card-desc\">Rulo etiket, kuşe etiket, şeffaf/opak çıkartmalar, termolaklı ve güvenlik hologramlı endüstriyel etiketler.</p>\n            </div>\n            <a href=\"/shop/\" class=\"ekiz-card-link\">Detayları Gör &rarr;</a>\n        </div>\n\n        <!-- 8. Takvim & Masa Takvimi -->\n        <div class=\"ekiz-product-card\">\n            <div>\n                <div class=\"ekiz-card-icon\"><i class=\"porto-icon-calendar\"></i></div>\n                <h3 class=\"ekiz-card-title\">Takvim & Masa Takvimi</h3>\n                <p class=\"ekiz-card-desc\">Piramit masa takvimleri, gemici takvimleri, sümen takvimleri ve duvara asılan spiral ciltli kurumsal takvimler.</p>\n            </div>\n            <a href=\"/shop/\" class=\"ekiz-card-link\">Detayları Gör &rarr;</a>\n        </div>\n    </div>\n</div>\n"
              }
            }
          ]
        }
      ]
    },
