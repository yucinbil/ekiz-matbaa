              "id": "ekiz_hero_content",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div class=\"ekiz-hero-section\">\n    <div class=\"container text-center\" style=\"max-width: 960px; margin: 0 auto;\">\n        <span class=\"ekiz-badge-item\" style=\"margin-bottom: 20px;\">\n            <i class=\"porto-icon-check\"></i> 1987'den Beri 35+ Yıllık Matbaa Tecrübesi\n        </span>\n        <h1 class=\"ekiz-hero-title\">\n            İstanbul'un Güvenilir <span>Matbaa & Baskı</span> Çözüm Ortağı\n        </h1>\n        <p class=\"ekiz-hero-subtitle\" style=\"margin: 0 auto 30px auto;\">\n            Ofset baskı, lüks kutu & ambalaj üretimi, katalog, kurumsal kimlik ve promosyon ürünlerinde yüksek teknoloji, kusursuz renk yönetimi ve zamanında teslimat garantisi.\n        </p>\n        <div class=\"ekiz-btn-group\" style=\"justify-content: center; margin-bottom: 40px;\">\n            <a href=\"/iletisim/\" class=\"ekiz-btn-primary\">\n                <i class=\"porto-icon-mail\"></i> Hızlı Fiyat Teklifi Alın\n            </a>\n            <a href=\"https://api.whatsapp.com/send?phone=905363939306&text=Merhaba,%20matbaa%20baskı%20hizmetleriniz%20için%20fiyat%20teklifi%20almak%20istiyorum.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ekiz-btn-whatsapp\">\n                <i class=\"porto-icon-phone\"></i> WhatsApp ile Danışın\n            </a>\n            <a href=\"/shop/\" class=\"ekiz-btn-outline\">\n                Ürünlerimizi İnceleyin &rarr;\n            </a>\n        </div>\n        <div class=\"ekiz-trust-badges\" style=\"justify-content: center;\">\n            <div class=\"ekiz-badge-item\">✓ Profesyonel Grafik Kontrolü</div>\n            <div class=\"ekiz-badge-item\">✓ Son Teknoloji Ofset Parkur</div>\n            <div class=\"ekiz-badge-item\">✓ Hassas Renk & Prova Onayı</div>\n            <div class=\"ekiz-badge-item\">✓ Zamanında Teslimat</div>\n        </div>\n    </div>\n</div>\n"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ekiz_products_sec",
      "elType": "section",
      "isInner": false,
      "settings": {
        "layout": "boxed",
        "padding": {
